---
// Startsidan satt ur bibliotekets sektioner. Sidan väljer stilkit genom att importera kitets CSS och sätta data-kit.
import Sida from './Sida.astro';
import Forstavy from '../sektioner/Forstavy.astro';
import Praktiskt from '../sektioner/Praktiskt.astro';
import Tjanster from '../sektioner/Tjanster.astro';
import Person from '../sektioner/Person.astro';
import Fortroende from '../sektioner/Fortroende.astro';
import Process from '../sektioner/Process.astro';
import NastaSteg from '../sektioner/NastaSteg.astro';
import type { StartInnehall } from '../innehall/typ';

interface Props { kit: 'lugn' | 'varm' | 'djarv'; innehall: StartInnehall; noindex?: boolean; rorelse?: 'sparsam' | 'mattlig'; }
const { kit, innehall, noindex = false, rorelse } = Astro.props;
---
<Sida kit={kit} innehall={innehall} titel={innehall.titel} beskrivning={innehall.beskrivning} noindex={noindex} rorelse={rorelse}>
  <Forstavy innehall={innehall} />
  <Praktiskt innehall={innehall} />
  <Tjanster innehall={innehall} />
  <Person innehall={innehall} />
  <Fortroende innehall={innehall} />
  <Process innehall={innehall} />
  <NastaSteg innehall={innehall} />
</Sida>
