---
// Startsidan satt ur bibliotekets sektioner. Sidan väljer stilkit genom att importera kitets CSS och sätta data-kit.
import Sida from './Sida.astro';
import Forstavy from '../sektioner/Forstavy.astro';
import Praktiskt from '../sektioner/Praktiskt.astro';
import Tjanster from '../sektioner/Tjanster.astro';
import Person from '../sektioner/Person.astro';
import Fortroende from '../sektioner/Fortroende.astro';
import Process from '../sektioner/Process.astro';
import NastaSteg from '../sektioner/NastaSteg.astro';
import type { StartInnehall } from '../innehall/typ';

interface Props { kit: 'lugn' | 'varm' | 'djarv'; innehall: StartInnehall; noindex?: boolean; rorelse?: 'sparsam' | 'mattlig'; strukturerad?: object[]; }
const { kit, innehall, noindex = false, rorelse, strukturerad } = Astro.props;
---
<Sida kit={kit} innehall={innehall} titel={innehall.titel} beskrivning={innehall.beskrivning} noindex={noindex} rorelse={rorelse} strukturerad={strukturerad}>
  <Forstavy innehall={innehall} />
  <Praktiskt innehall={innehall} />
  <Tjanster innehall={innehall} />
  <Person innehall={innehall} />
  <Fortroende innehall={innehall} />
  <Process innehall={innehall} />
  <NastaSteg innehall={innehall} />
  <script is:inline>
    // Bara för jämförelsen av sektionsordningen: ?ordning=behandlingar lägger Tjänster före Det praktiska.
    // Noderna flyttas i dokumentet, så att läsordning och tabbordning följer det som syns.
    (function () {
      if (new URLSearchParams(location.search).get('ordning') !== 'behandlingar') return;
      var p = document.querySelector('.praktiskt'), t = document.querySelector('.tjanster');
      if (p && t) p.parentNode.insertBefore(t, p);
    })();
  </script>
</Sida>
