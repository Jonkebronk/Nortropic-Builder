---
// Den gemensamma sidmallen: dokumentet, sidhuvudet, huvudinnehållet och sidfoten.
// Mallen sätter sidans landmärken och länken Hoppa till innehållet (guide/2-4-skelett.md).
import '../styles/bas.css';
import '../styles/rorelse.css';
import Sidhuvud from '../sektioner/Sidhuvud.astro';
import Sidfot from '../sektioner/Sidfot.astro';
import Kontaktlist, { type Knappval } from '../sektioner/Kontaktlist.astro';
import Samtycke from '../sektioner/Samtycke.astro';
import { samtyckeStandard, rorelseJamforelse as rorelseJamforelseSkript } from '../komponenter/inlineskript.mjs';
import type { StartInnehall } from '../innehall/typ';

// strukturerad: JSON-LD för sökmotorer, t.ex. en klinik per mottagning (Google Search Central, LocalBusiness).
// lista: knapplistens och sidhuvudets knappar när sidans primära handling inte är Boka, t.ex. Ring och Mejla på en företagssida.
// rorelseJamforelse: bara på provsidor som jämför de två rörelseversionerna med ?rorelse=; en vanlig sajt bär inte skriptet.
interface Props { kit: 'lugn' | 'varm' | 'djarv'; innehall: StartInnehall; titel: string; beskrivning: string; noindex?: boolean; rorelse?: 'sparsam' | 'mattlig'; rorelseJamforelse?: boolean; strukturerad?: object[]; lista?: { primar: Knappval; sekundar: Knappval; etikett?: string }; }
const { kit, innehall, titel, beskrivning, noindex = false, rorelse = 'sparsam', rorelseJamforelse = false, strukturerad = [], lista } = Astro.props;
const adress = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const delning = Astro.site && innehall.foretag.delningsbild ? new URL(innehall.foretag.delningsbild, Astro.site).href : undefined;
---
<!doctype html>
<html lang="sv" data-kit={kit} data-rorelse={rorelse} data-lista={innehall.mobilLista ?? 'nere'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {innehall.foretag.temafarg && <meta name="theme-color" content={innehall.foretag.temafarg} />}
    <title>{titel}</title>
    <meta name="description" content={beskrivning} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {adress && !noindex && <link rel="canonical" href={adress} />}
    {innehall.foretag.favikon && <link rel="icon" href={innehall.foretag.favikon} type="image/png" sizes="48x48" />}
    {innehall.foretag.favikonStor && <link rel="icon" href={innehall.foretag.favikonStor} type="image/png" sizes="96x96" />}
    {innehall.foretag.hemskarmsikon && <link rel="apple-touch-icon" href={innehall.foretag.hemskarmsikon} />}
    {innehall.foretag.manifest && <link rel="manifest" href={innehall.foretag.manifest} />}
    {innehall.foretag.hemskarmsnamn && <meta name="apple-mobile-web-app-title" content={innehall.foretag.hemskarmsnamn} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={innehall.foretag.namn} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    {adress && !noindex && <meta property="og:url" content={adress} />}
    {/* Delningsbilden är 1200 × 630 px (skript/ikoner.mjs). Måtten låter tjänsterna visa den direkt vid första delningen (Open Graph protocol, ogp.me). */}
    {delning && <meta property="og:image" content={delning} />}
    {delning && <meta property="og:image:width" content="1200" />}
    {delning && <meta property="og:image:height" content="630" />}
    {delning && innehall.foretag.delningsbildText && <meta property="og:image:alt" content={innehall.foretag.delningsbildText} />}
    {delning && <meta name="twitter:card" content="summary_large_image" />}
    {/* < skrivs som \u003c så att en text i datan aldrig kan avsluta skripttaggen (OWASP, XSS Prevention Cheat Sheet). */}
    {strukturerad.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
    {/* Consent Mode v2 före alla Googles taggar; texten och dess CSP-hash kommer ur komponenter/inlineskript.mjs. */}
    {innehall.samtycke?.googleSamtyckeslage && <script is:inline set:html={samtyckeStandard} />}
    {rorelseJamforelse && <script is:inline set:html={rorelseJamforelseSkript} />}
  </head>
  <body data-ny-flik-text={innehall.nyFlikText}>
    <a class="hoppa" href="#innehall">Hoppa till innehållet</a>
    <Samtycke innehall={innehall} />
    <Sidhuvud innehall={innehall} knappar={lista} />
    <main id="innehall">
      <slot />
    </main>
    <Sidfot innehall={innehall} />
    {(innehall.mobilLista ?? 'nere') === 'nere' && <Kontaktlist innehall={innehall} {...lista} />}
    {innehall.samtycke && innehall.taggar?.map((t) => <script is:inline type="text/plain" data-samtycke={t.kategori} data-src={t.src} set:html={t.kod ?? ''} />)}
    <script>
      // På iPhone och iPad går kartlänkar med data-apple till Apple Kartor; annars till Google Maps.
      // En iPad med skrivbordsläge säger Macintosh men har pekskärm.
      const apple = /iPhone|iPad|iPod/.test(navigator.userAgent) || (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
      if (apple) document.querySelectorAll<HTMLAnchorElement>('a[data-apple]').forEach((a) => { if (a.dataset.apple) a.href = a.dataset.apple; });
      // Länkar till kartor, recensioner och sociala medier (data-ny-flik) öppnas i ny flik på datorn, så att besökaren har
      // sajten kvar. På mobilen öppnas de i samma flik, där appen tar över (Johnny 2026-10-16; kontroll 2b i skript/kontroll.mjs).
      // Skärmläsare får veta att en ny flik öppnas (WCAG-teknik G201).
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const ny = document.body.dataset.nyFlikText;
        document.querySelectorAll<HTMLAnchorElement>('a[data-ny-flik]').forEach((a) => {
          a.target = '_blank'; a.rel = 'noopener';
          if (!ny) return;
          const etikett = a.getAttribute('aria-label');
          if (etikett) a.setAttribute('aria-label', `${etikett} ${ny}`);
          else { const s = document.createElement('span'); s.className = 'sr-only'; s.textContent = ` ${ny}`; a.append(s); }
        });
      }
    </script>
  </body>
</html>
