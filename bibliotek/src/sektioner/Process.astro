---
// Process: hur första besöket eller uppdraget går till, i numrerade steg (guide/2-4-skelett.md).
// Listan har role="list", eftersom VoiceOver i Safari annars läser en lista utan punkter som vanlig text (WebKit, bugg 170179).
import type { StartInnehall } from '../innehall/typ';
interface Props { innehall: StartInnehall; }
const { process } = Astro.props.innehall;
---
<section class="sektion process" data-yta="yta">
  <div class="behallare">
    <div class="sektion__huvud"><h2>{process.rubrik}</h2></div>
    <ol class="process__steg" role="list">
      {process.steg.map((s) => (
        <li class="kort"><h3>{s.rubrik}</h3><p class="dampad">{s.text}</p></li>
      ))}
    </ol>
    {process.not && <p class="process__not dampad">{process.not}</p>}
  </div>
</section>

<style>
  .process { background: var(--k-yta); }
  .process__steg { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--k-a4); counter-reset: steg; }
  .process__steg li { counter-increment: steg; background: var(--k-bg); }
  /* Stegsiffran är dekor och får textens färg; accenten är till för handlingar (Johnny 2026-10-16, C6). */
  .process__steg li::before {
    content: counter(steg);
    font-family: var(--k-font-rubrik); font-weight: var(--k-rubrik-vikt); font-size: 2rem; line-height: 1; color: var(--k-text);
  }
  .process__not { margin-top: var(--k-a5); max-width: var(--k-matt); }
  /* I mobilen en tunn tidslinje i stället för tre kort under varandra: siffran i en ring, en linje till nästa steg och ingen kortyta.
     Sektionen tar då ungefär hälften så mycket höjd och skiljer sig från kortnäten runt den (premiumpasset P27; frågelistan 9;
     Claudes rekommendation, delegerat av Johnny 2026-10-16). */
  @media (max-width: 47.99rem) {
    .process__steg { gap: 0; }
    .process__steg li.kort { position: relative; display: grid; gap: var(--k-a1); background: none; border-radius: 0; padding: 0 0 var(--k-a5) 3rem; }
    .process__steg li::before {
      position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; display: grid; place-items: center;
      font-size: 1rem; border: 1.5px solid var(--k-text); border-radius: 50%; background: var(--k-yta);
    }
    .process__steg li:not(:last-child)::after { content: ''; position: absolute; left: calc(1rem - 0.75px); top: 2.25rem; bottom: 0.25rem; width: 1.5px; background: var(--k-linje); }
    .process__steg li:last-child { padding-bottom: 0; }
    .process__steg h3 { padding-top: 0.2rem; }
  }
  @media (min-width: 48rem) { .process__steg { grid-template-columns: repeat(3, 1fr); } }
</style>
