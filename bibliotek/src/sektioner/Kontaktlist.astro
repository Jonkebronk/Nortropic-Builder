---
// Knapplisten i tumzonen på mobilen, läge 'nere' (Sidhuvud.astro). Som standard är Boka bred och primär och Ring sekundär.
// En sida med en annan primär handling skickar egna knappar, som Ring och Mejla på en företagssida (Johnny 2026-10-16).
// Den visas först när förstavyns eller sidtoppens egna knappar har scrollats ur bild, så att den aldrig dubblerar
// eller täcker dem (Johnnys dom över Citykiropraktikern i mattstock/domar.jsonl). Av samma skäl göms den igen när sista bandets
// knappar (NastaSteg) syns, så att samma två knappar aldrig står två gånger på skärmen (premiumpasset 2026-10-16). Fast höjd, hänsyn till iPhones
// nederkant och scroll-padding i bas, så att den aldrig skymmer innehåll eller fokus (WCAG 2.2, 2.4.11).
// Utan JavaScript ligger listen alltid synlig.
// Vid låg höjd (liggande telefon, 400 % zoom) ligger listen sist i flödet i stället för fast, så att texten får plats
// (Johnny 2026-10-16, kvalitetsgranskningen C3; WCAG 2.2, 1.4.10).
// Medan samtyckesrutan är öppen göms listen, utom när rutan täcker förstavyns knappar på en liten skärm. Då ligger listen
// under rutan, så att Boka och Ring alltid går att nå (kvalitetsgranskningen 2026-10-16, U1).
import Knapp from '../komponenter/Knapp.astro';
import type { IkonNamn } from '../komponenter/Ikon.astro';
import type { StartInnehall } from '../innehall/typ';
export interface Knappval { href: string; text: string; ikon?: IkonNamn; etikett?: string; }
// etikett: landmärkets namn för skärmläsare; listen är en nav, så att den finns i landmärkeslistan (axe region; premiumpasset P16).
interface Props { innehall: StartInnehall; primar?: Knappval; sekundar?: Knappval; etikett?: string; }
const { boka, ring } = Astro.props.innehall;
const primar = Astro.props.primar ?? { href: boka.href, text: boka.kort ?? boka.text, ikon: 'kalender' };
const sekundar = Astro.props.sekundar ?? { href: ring.href, text: ring.kort ?? ring.text, ikon: 'telefon', etikett: `Ring ${ring.nummer}` };
---
<nav class="kontaktlist" data-kontaktlist aria-label={Astro.props.etikett ?? 'Boka eller ring'}>
  <Knapp href={primar.href} text={primar.text} ikon={primar.ikon} etikett={primar.etikett} />
  <Knapp href={sekundar.href} text={sekundar.text} variant="sekundar" ikon={sekundar.ikon} etikett={sekundar.etikett} />
</nav>

<script>
  const list = document.querySelector<HTMLElement>('[data-kontaktlist]');
  const egna = document.querySelectorAll('.forstavy__knappar, .sidtopp__knappar, .nasta__knappar');
  const meny = document.getElementById('meny');
  if (list) {
    const ruta = document.querySelector<HTMLElement>('[data-samtycke-ruta]');
    let egnaSyns = false, menyOppen = false, samtyckeOppen = !!ruta && !ruta.hidden;
    const lag = matchMedia('(max-height: 30rem)'), smal = matchMedia('(max-width: 63.99rem)');
    // Syns förstavyns eller sidtoppens knappar helt ovanför samtyckesrutan?
    const egnaOvanRutan = () => {
      if (!egna.length || !ruta) return false;
      const k = egna[0].getBoundingClientRect();
      return k.top >= 0 && k.bottom <= ruta.getBoundingClientRect().top;
    };
    const uppdatera = () => {
      const underRuta = samtyckeOppen && smal.matches && !lag.matches && !menyOppen && !egnaOvanRutan();
      const dold = !lag.matches && !underRuta && (egnaSyns || menyOppen || samtyckeOppen);
      list.dataset.dold = String(dold);
      list.inert = dold;
      if (document.documentElement.hasAttribute('data-lista-under-ruta') !== underRuta) {
        document.documentElement.toggleAttribute('data-lista-under-ruta', underRuta);
        document.dispatchEvent(new CustomEvent('kontaktlist'));
      }
    };
    if (egna.length && 'IntersectionObserver' in window) {
      const synliga = new Set<Element>();
      const iakttagare = new IntersectionObserver((poster) => {
        for (const p of poster) p.isIntersecting ? synliga.add(p.target) : synliga.delete(p.target);
        egnaSyns = synliga.size > 0; uppdatera();
      });
      egna.forEach((e) => iakttagare.observe(e));
    }
    lag.addEventListener('change', uppdatera); smal.addEventListener('change', uppdatera);
    window.addEventListener('scroll', () => { if (samtyckeOppen) uppdatera(); }, { passive: true });
    meny?.addEventListener('toggle', (e) => { menyOppen = (e as ToggleEvent).newState === 'open'; uppdatera(); });
    document.addEventListener('samtyckeruta', (e) => { samtyckeOppen = (e as CustomEvent<boolean>).detail; uppdatera(); });
    // Samtyckesrutan kan redan vara öppnad innan skriptet här körs, och en sida utan egna knappar får ingen signal från observatören.
    uppdatera();
  }
</script>

<style>
  .kontaktlist {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
    display: grid; grid-template-columns: 1.6fr 1fr; gap: var(--k-a2);
    padding: var(--k-a2) var(--k-a4) calc(var(--k-a2) + env(safe-area-inset-bottom));
    background: var(--k-yta); border-top: 1px solid var(--k-linje); box-shadow: 0 -4px 16px rgb(0 0 0 / 0.06);
    transition: transform 260ms var(--k-kurva), opacity 260ms var(--k-kurva);
  }
  .kontaktlist :global(.knapp) { min-height: 48px; padding-inline: 0.75rem; }
  .kontaktlist[data-dold="true"] { transform: translateY(110%); opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .kontaktlist { transition: opacity 200ms linear; } .kontaktlist[data-dold="true"] { transform: none; } }
  /* I flödet staplas knapparna, så att de får plats också vid 200 % text, där 30rem växer med texten (andra varvet 2026-10-16). */
  @media (max-height: 30rem) { .kontaktlist { position: static; box-shadow: none; transition: none; grid-template-columns: 1fr; } }
  @media (min-width: 64rem) { .kontaktlist { display: none; } }
</style>
