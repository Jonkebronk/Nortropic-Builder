---
// Vanliga frågor som utfällbara <details name>, utan JavaScript (guide/2-4-skelett.md, primitiverna).
interface Props { rubrik: string; fragor: { fraga: string; svar: string }[]; }
const { rubrik, fragor } = Astro.props;
---
<section class="sektion fragor" aria-labelledby="fragor-rubrik">
  <div class="behallare fragor__inre">
    <h2 id="fragor-rubrik">{rubrik}</h2>
    <div class="fragor__lista">
      {fragor.map((f) => (
        <details name="fragor" class="fragor__post">
          <summary>{f.fraga}</summary>
          <p>{f.svar}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .fragor__inre { display: grid; gap: var(--k-a5); max-width: 46rem; margin-inline: auto; }
  .fragor__lista { display: grid; gap: var(--k-a2); }
  .fragor__post { background: var(--k-yta); border-radius: var(--k-radie-kort); border: 1px solid var(--k-linje); }
  .fragor__post summary { cursor: pointer; padding: var(--k-a4) var(--k-a5); font-weight: 600; min-height: 48px; list-style-position: inside; }
  .fragor__post p { padding: 0 var(--k-a5) var(--k-a4); }
</style>
