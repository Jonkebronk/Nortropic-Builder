---
// Vanliga frågor som utfällbara <details> utan name, så att flera svar kan vara öppna och frågan inte hoppar, utan JavaScript (guide/2-4-skelett.md, primitiverna; BESLUT.md 2026-10-16).
// Spalten börjar vid behållarens vänsterkant som de andra sektionerna, och svaret börjar under frågans text.
// Webbläsarens triangel byts mot Lucides chevron, så att alla ikoner har samma stil (kvalitetsgranskningen 2026-10-16, D3 och D21).
import Ikon from '../komponenter/Ikon.astro';
interface Props { rubrik: string; fragor: { fraga: string; svar: string }[]; id?: string; }
const { rubrik, fragor, id = 'fragor' } = Astro.props;
---
<section class="sektion fragor" id={id} aria-labelledby={`${id}-rubrik`} data-yta="bg">
  <div class="behallare fragor__inre">
    <h2 id={`${id}-rubrik`}>{rubrik}</h2>
    <div class="fragor__lista">
      {fragor.map((f) => (
        <details class="fragor__post">
          <summary><span>{f.fraga}</span><Ikon namn="chevron" /></summary>
          <p>{f.svar}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .fragor__inre { display: grid; gap: var(--k-a5); }
  .fragor__inre > * { max-width: 46rem; }
  .fragor__lista { display: grid; gap: var(--k-a2); }
  .fragor__post { background: var(--k-yta); border-radius: var(--k-radie-kort); }
  .fragor__post summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--k-a4);
    cursor: pointer; padding: var(--k-a4) var(--k-a5); font-weight: 600; min-height: 48px; list-style: none;
  }
  .fragor__post summary::-webkit-details-marker { display: none; }
  .fragor__post summary :global(svg) { width: var(--k-ikon-text); height: var(--k-ikon-text); flex: none; transition: transform var(--k-tid) var(--k-kurva); }
  .fragor__post[open] summary :global(svg) { transform: rotate(180deg); }
  .fragor__post p { padding: 0 var(--k-a5) var(--k-a4); max-width: calc(var(--k-matt) + 2 * var(--k-a5)); }
</style>
