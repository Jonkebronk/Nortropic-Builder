---
// Sidfoten: mottagningarna med adressen som kartlänk, kontaktvägarna och en kort lista över sajtens sidor.
// Besökare letar efter kontaktuppgifter och det som saknas i menyn i sidfoten (NN/g, Footers). Ingen text i komponenten.
import Ikon from '../komponenter/Ikon.astro';
import { hartPostnummer } from '../komponenter/text';
import type { StartInnehall } from '../innehall/typ';
interface Props { innehall: StartInnehall; }
const { foretag, sidfot, ring, samtycke } = Astro.props.innehall;
const r = sidfot.rubriker;
---
<footer class="sidfot" data-foretagsform={foretag.form ?? 'okand'}>
  <div class="behallare sidfot__rutnat">
    <p class="sidfot__namn">{foretag.namn}</p>
    <div>
      {r && <h2 class="sidfot__rubrik">{r.platser}</h2>}
      <ul class="sidfot__lista">
        {sidfot.platser.map((p) => (
          <li><strong>{p.namn}</strong><br />
            {p.karta
              ? <a class="sidfot__adress" href={p.karta.href} data-apple={p.karta.apple} data-ny-flik rel="noopener" aria-label={`${p.karta.text}: ${p.adress}`}><Ikon namn="plats" /><span>{hartPostnummer(p.adress)}</span></a>
              : hartPostnummer(p.adress)}
          </li>
        ))}
      </ul>
    </div>
    <div>
      {r && <h2 class="sidfot__rubrik">{r.kontakt}</h2>}
      <ul class="sidfot__lista">
        <li><a href={ring.href}>{ring.nummer}</a></li>
        {sidfot.epost && <li><a href={sidfot.epost.href}>{sidfot.epost.text}</a></li>}
        {sidfot.sociala.map((l) => <li><a href={l.href} data-ny-flik rel="noopener">{l.text}</a></li>)}
      </ul>
    </div>
    {sidfot.sidor && (
      <nav aria-label={r?.sidor ?? undefined}>
        {r && <h2 class="sidfot__rubrik">{r.sidor}</h2>}
        <ul class="sidfot__lista">{sidfot.sidor.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
      </nav>
    )}
  </div>
  <div class="behallare sidfot__rad">
    {foretag.form === 'bolag' && foretag.orgnr && <p class="sidfot__uppgifter">{foretag.namn} · Organisationsnummer {foretag.orgnr}</p>}
    {(sidfot.policy || samtycke) && (
      <ul class="sidfot__policy">
        {sidfot.policy?.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
        {samtycke && <li><button type="button" class="sidfot__knapplank" data-samtycke-installningar>{samtycke.installningar}</button></li>}
      </ul>
    )}
    {sidfot.rad && <p>{sidfot.rad}</p>}
  </div>
</footer>

<style>
  .sidfot { background: var(--k-bg); border-top: 1px solid var(--k-linje); padding-block: var(--k-a7) var(--k-a5); font-size: 0.95rem; }
  .sidfot__rutnat { display: grid; gap: var(--k-a6); }
  .sidfot__namn { font-family: var(--k-font-rubrik); font-weight: var(--k-rubrik-vikt); text-transform: var(--k-rubrik-versaler); font-size: 1.25rem; }
  .sidfot__rubrik { font-family: var(--k-font-brod); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--k-dampad); margin-bottom: var(--k-a3); }
  .sidfot__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--k-a3); }
  .sidfot__lista a { color: var(--k-text); display: inline-block; min-height: 24px; }
  .sidfot__adress { display: inline-flex !important; gap: var(--k-a1); align-items: flex-start; }
  .sidfot__adress :global(svg) { width: 1rem; height: 1rem; margin-top: 0.25rem; flex: none; color: var(--k-accent-text); }
  .sidfot__rad { margin-top: var(--k-a6); color: var(--k-dampad); font-size: 0.85rem; display: grid; gap: var(--k-a3); }
  .sidfot__policy { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--k-a2) var(--k-a5); }
  .sidfot__policy a { color: var(--k-text); display: inline-flex; min-height: 24px; align-items: center; }
  .sidfot__knapplank { background: none; border: 0; padding: 0; min-height: 24px; font: inherit; color: var(--k-text); text-decoration: underline; cursor: pointer; }
  @media (min-width: 48rem) { .sidfot__rutnat { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .sidfot__rutnat { grid-template-columns: 1.2fr 1.4fr 1fr 1fr; } }
</style>
