---
// Tjänster: en rad per huvudtjänst, en mening var och en länk till tjänstens sida (guide/2-3-struktur.md).
// Listan har role="list", eftersom VoiceOver i Safari annars läser en lista utan punkter som vanlig text (WebKit, bugg 170179).
import Ikon from '../komponenter/Ikon.astro';
import Uppmaning from '../komponenter/Uppmaning.astro';
import type { StartInnehall } from '../innehall/typ';
interface Props { innehall: StartInnehall; }
const { tjanster } = Astro.props.innehall;
---
<section class="sektion tjanster" id={tjanster.id} aria-labelledby="tjanster-rubrik" data-yta="dekor">
  <div class="behallare">
    <div class="sektion__huvud">
      <h2 id="tjanster-rubrik">{tjanster.rubrik}</h2>
      {tjanster.ingress && <p class="dampad">{tjanster.ingress}</p>}
    </div>
    <ul class="tjanster__lista" role="list">
      {tjanster.poster.map((t) => (
        <li class="kort">
          <span class="tjanster__ikon"><Ikon namn={t.ikon} /></span>
          <h3>{t.namn}</h3>
          <p>{t.text}</p>
          <span class="tjanster__lank"><Uppmaning href={t.lank.href} text={t.lank.text} /></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tjanster { background: color-mix(in srgb, var(--k-dekor) 45%, var(--k-bg)); }
  .tjanster__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--k-a4); }
  /* Ikonen är dekor och får textens färg; accenten är till för handlingar (Johnny 2026-10-16, C6). */
  .tjanster__ikon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--k-bg); color: var(--k-text); }
  .tjanster__ikon :global(svg) { width: var(--k-ikon); height: var(--k-ikon); }
  .tjanster__lank { margin-top: auto; }
  @media (min-width: 40rem) { .tjanster__lista { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .tjanster__lista { grid-template-columns: repeat(4, 1fr); } }
</style>
