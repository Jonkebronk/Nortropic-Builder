---
// Samtyckesverktyget, bara på sajter som har statistik eller annonser med kakor (BESLUT.md 2026-10-16, Kakor och samtycke vid behov;
// guide/2-8-teknik-och-kvalitet.md). PTS: samtycket är frivilligt, specifikt per ändamål, informerat och aktivt; det är lika lätt att neka
// som att godkänna och lika lätt att återkalla; inget sätts före svaret. Båda huvudknapparna har därför samma utseende, rutorna är tomma
// från början och skript som kräver samtycke ligger som <script type="text/plain" data-samtycke="…"> tills besökaren har sagt ja.
// Första lagret säger vem som frågar, ändamålen, vilka andra som får uppgifterna och vilka uppgifter, och att man kan ändra sig
// (EDPB, riktlinjer 05/2020 om samtycke, p. 64–65; PTS, Kakor). Överföringar till tredje land står i integritetspolicyn (GDPR art. 13.1 f);
// i rutan behövs de bara när mottagaren saknar adekvansbeslut, som Data Privacy Framework för USA (p. 64 vi).
// Valet sparas i webbläsaren så att frågan inte ställs på varje sida; att spara själva valet räknas som nödvändigt (⚖️ tolkning).
// Ett val gäller i högst giltighetDagar, sedan frågar rutan igen (CNIL rekommenderar sex månader; ⚠️ ingen svensk norm).
// Rutan är inte modal: sajten går att använda innan besökaren svarar, och inget laddas under tiden. Medan den är öppen får sidan
// lika mycket luft nedtill som rutan är hög, så att fokus aldrig hamnar bakom den (WCAG 2.2, 2.4.11; WCAG-teknik C43).
import type { StartInnehall } from '../innehall/typ';
interface Props { innehall: StartInnehall; }
const s = Astro.props.innehall.samtycke;
---
{s && (
  <section class="samtycke" data-samtycke-ruta data-version={s.version} data-giltighet={s.giltighetDagar ?? 182} data-logg={s.logg} data-google={s.googleSamtyckeslage ? 'ja' : undefined} hidden aria-labelledby="samtycke-rubrik">
    <div class="samtycke__inre" data-samtycke-fraga>
      <h2 id="samtycke-rubrik" class="samtycke__rubrik">{s.rubrik}</h2>
      <p class="samtycke__text">{s.text}{s.lank && <> <a href={s.lank.href}>{s.lank.text}</a></>}</p>
      <fieldset class="samtycke__val" id="samtycke-val" hidden>
        <legend class="sr-only">{s.valj}</legend>
        {s.kategorier.map((k) => (
          <label class="samtycke__kategori">
            <input type="checkbox" name={k.id} data-kvittonamn={k.namn.toLowerCase()} />
            <span><strong>{k.namn}.</strong> {k.text}</span>
          </label>
        ))}
        <p class="samtycke__omladdning" data-samtycke-omladdning hidden>{s.kvitto.omladdning}</p>
      </fieldset>
      <div class="samtycke__knappar">
        <button type="button" class="knapp knapp--sekundar" data-samtycke-svar="ja">{s.godkann}</button>
        <button type="button" class="knapp knapp--sekundar" data-samtycke-svar="nej">{s.neka}</button>
        <button type="button" class="knapp knapp--sekundar" data-samtycke-svar="spara" hidden>{s.spara}</button>
        <button type="button" class="samtycke__valj knapp-ton" data-samtycke-visa-val data-valj={s.valj} data-dolj={s.dolj} aria-expanded="false" aria-controls="samtycke-val">{s.valj}</button>
      </div>
    </div>
    {/* Bekräftelsen efter svaret: fokus flyttas hit, så att skärmläsare får veta vad som hände (WCAG 2.2, 4.1.3 och 2.4.3). */}
    <div class="samtycke__kvitto" data-samtycke-kvitto tabindex="-1" role="status" hidden data-ja={s.kvitto.ja} data-nej={s.kvitto.nej} data-val={s.kvitto.val} data-val-mall={s.kvitto.valMall}>
      <p><span data-samtycke-kvittotext></span> {s.kvitto.andra}</p>
      <button type="button" class="samtycke__valj knapp-ton" data-samtycke-stang>{s.kvitto.stang}</button>
    </div>
  </section>
)}

<script>
  const ruta = document.querySelector<HTMLElement>('[data-samtycke-ruta]');
  if (ruta) {
    const NYCKEL = 'samtycke';
    const version = Number(ruta.dataset.version || 1);
    const giltighet = Number(ruta.dataset.giltighet || 182) * 864e5;
    const fraga = ruta.querySelector<HTMLElement>('[data-samtycke-fraga]')!;
    const kvitto = ruta.querySelector<HTMLElement>('[data-samtycke-kvitto]')!;
    const rutor = [...ruta.querySelectorAll<HTMLInputElement>('#samtycke-val input')];
    const kategorier = rutor.map((r) => r.name);
    const valFalt = ruta.querySelector<HTMLElement>('#samtycke-val')!;
    const omladdning = ruta.querySelector<HTMLElement>('[data-samtycke-omladdning]')!;
    const sparaKnapp = ruta.querySelector<HTMLElement>('[data-samtycke-svar="spara"]')!;
    const valjKnapp = ruta.querySelector<HTMLElement>('[data-samtycke-visa-val]')!;
    let oppnadFran: HTMLElement | null = null;

    type Val = Record<string, boolean>;
    type Sparat = Val & { id?: string; tid?: string };
    // Ett sparat val gäller bara för den här versionen av rutan och bara i giltighetstiden.
    const las = (): Sparat | null => {
      try {
        const v = JSON.parse(localStorage.getItem(NYCKEL) || 'null');
        return v && v.version === version && Date.now() - Date.parse(v.tid) < giltighet ? v : null;
      } catch { return null; }
    };
    // Ett ja sparas med ett slumpat id och skickas till loggen, så att samtycket går att visa (GDPR art. 7.1; Googles policy för
    // användarsamtycke). Ett nej loggas bara när det återkallar ett tidigare ja; annars får det inget id (kvalitetsgranskningen 2026-10-16, J3).
    // Loggen får id, version, valen och sidan, men ingen IP-adress.
    const spara = (val: Val, fore: Sparat | null) => {
      const nagotJa = kategorier.some((k) => val[k]);
      const aterkallar = !!fore?.id && kategorier.some((k) => fore[k] && !val[k]);
      const id = nagotJa || aterkallar ? (fore?.id ?? (crypto.randomUUID ? crypto.randomUUID() : String(Math.random()).slice(2))) : undefined;
      try { localStorage.setItem(NYCKEL, JSON.stringify({ ...val, id, version, tid: new Date().toISOString() })); } catch { /* utan lagring frågar rutan igen nästa gång */ }
      if (id && ruta.dataset.logg) fetch(ruta.dataset.logg, { method: 'POST', headers: { 'content-type': 'application/json' }, keepalive: true,
        body: JSON.stringify({ id, version, val, sida: location.pathname }) }).catch(() => { /* loggen får inte hindra sajten */ });
    };
    // Consent Mode v2: valet skickas till Googles taggar på varje sida, eftersom Consent Mode inte sparar det själv.
    const signalera = (val: Val) => {
      const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
      if (!ruta.dataset.google || !g) return;
      const s = (b?: boolean) => (b ? 'granted' : 'denied');
      g('consent', 'update', { analytics_storage: s(val.statistik), ad_storage: s(val.marknadsforing), ad_user_data: s(val.marknadsforing), ad_personalization: s(val.marknadsforing) });
    };
    // Skripten för en godkänd kategori byts mot riktiga skript. Det som inte är godkänt laddas aldrig.
    const aktivera = (val: Val) => {
      signalera(val);
      for (const k of kategorier) {
        if (!val[k]) continue;
        document.documentElement.dataset[`samtycke${k[0].toUpperCase()}${k.slice(1)}`] = 'ja';
        document.querySelectorAll<HTMLScriptElement>(`script[type="text/plain"][data-samtycke="${k}"]`).forEach((vilande) => {
          const skript = document.createElement('script');
          if (vilande.dataset.src) { skript.src = vilande.dataset.src; skript.async = true; }
          else skript.text = vilande.text;
          vilande.replaceWith(skript);
        });
      }
      document.dispatchEvent(new CustomEvent('samtycke', { detail: val }));
    };
    // Vid återkallelse tas sajtens egna kakor bort och sidan laddas om, så att inget som redan körts fortsätter.
    const rensaKakor = () => {
      const doman = location.hostname.replace(/^www\./, '');
      for (const del of document.cookie.split(';')) {
        const namn = del.split('=')[0].trim();
        if (!namn) continue;
        for (const d of ['', `; domain=${doman}`, `; domain=.${doman}`]) document.cookie = `${namn}=; Max-Age=0; path=/${d}`;
      }
    };
    const visaVal = (visa: boolean) => {
      valFalt.hidden = !visa; sparaKnapp.hidden = !visa;
      valjKnapp.setAttribute('aria-expanded', String(visa));
      valjKnapp.textContent = (visa ? valjKnapp.dataset.dolj : valjKnapp.dataset.valj) ?? '';
    };
    // Luft nedtill lika hög som rutan, så att sidan går att läsa och tabba igenom ovanför den (WCAG-teknik C43).
    const html = document.documentElement;
    // Avståndet från rutans överkant till fönstrets underkant, så att knapplisten räknas med när den ligger under rutan.
    const luft = () => {
      const h = ruta.hidden ? 0 : Math.max(0, innerHeight - ruta.getBoundingClientRect().top) + 16;
      html.style.scrollPaddingBottom = h ? `${h}px` : '';
      document.body.style.paddingBottom = h ? `${h}px` : '';
    };
    const storlek = 'ResizeObserver' in window ? new ResizeObserver(luft) : null;
    document.addEventListener('kontaktlist', luft);
    // Webbläsaren rullar inte fram ett element som redan syns i fönstret men ligger bakom rutan, så det görs här.
    // scrollIntoView följer scroll-padding och lägger elementet ovanför rutan, direkt och utan mjuk rullning, så att fokus syns genast.
    document.addEventListener('focusin', (e) => {
      const el = e.target as HTMLElement;
      if (ruta.hidden || ruta.contains(el) || !el.getBoundingClientRect) return;
      if (el.getBoundingClientRect().bottom > ruta.getBoundingClientRect().top) el.scrollIntoView({ block: 'nearest', behavior: 'instant' });
    });
    const visa = (oppen: boolean) => {
      ruta.hidden = !oppen;
      if (oppen) storlek?.observe(ruta); else storlek?.disconnect();
      luft();
      document.dispatchEvent(new CustomEvent('samtyckeruta', { detail: oppen }));
    };
    const stang = () => {
      visa(false);
      fraga.hidden = false; kvitto.hidden = true;
      oppnadFran?.focus(); oppnadFran = null;
    };

    const tidigare = las();
    if (tidigare) aktivera(tidigare); else visa(true);

    ruta.addEventListener('click', (e) => {
      const knapp = (e.target as HTMLElement).closest('button');
      if (!knapp) return;
      if (knapp === valjKnapp) { visaVal(valFalt.hidden === true); if (!valFalt.hidden) rutor[0]?.focus(); return; }
      if (knapp.hasAttribute('data-samtycke-stang')) { stang(); return; }
      const svar = knapp.dataset.samtyckeSvar;
      if (!svar) return;
      const val: Val = Object.fromEntries(rutor.map((r) => [r.name, svar === 'ja' ? true : svar === 'nej' ? false : r.checked]));
      const fore = las();
      spara(val, fore);
      if (fore && kategorier.some((k) => fore[k] && !val[k])) { rensaKakor(); location.reload(); return; }
      aktivera(val);
      // Rutan byts mot en kort bekräftelse som får fokus. Den stängs med knappen eller när fokus lämnar rutan.
      const text = ruta.querySelector<HTMLElement>('[data-samtycke-kvittotext]')!;
      // Egna val: kvittot säger vad besökaren valde, så att nej syns som nej (GOV.UK, Confirmation pages; premiumpasset P13).
      // Inget ikryssat är ett nej och allt ikryssat ett ja; annars fylls mallen med kategoriernas namn.
      const lista = (n: string[]) => n.length > 1 ? `${n.slice(0, -1).join(', ')} och ${n[n.length - 1]}` : n[0] ?? '';
      const ja = rutor.filter((r) => r.checked).map((r) => r.dataset.kvittonamn ?? r.name), nej = rutor.filter((r) => !r.checked).map((r) => r.dataset.kvittonamn ?? r.name);
      const egna = kvitto.dataset.valMall ? (!ja.length ? kvitto.dataset.nej : !nej.length ? kvitto.dataset.ja : kvitto.dataset.valMall.replace('{ja}', lista(ja)).replace('{nej}', lista(nej))) : kvitto.dataset.val;
      text.textContent = (svar === 'ja' ? kvitto.dataset.ja : svar === 'nej' ? kvitto.dataset.nej : egna) ?? '';
      visaVal(false);
      fraga.hidden = true; kvitto.hidden = false;
      kvitto.focus({ preventScroll: true });
      // Rutan blir lägre när bekräftelsen visas, och det kan flytta sidan något; rullningen räknas från nästa bildruta.
      requestAnimationFrame(() => { rullStart = scrollY; });
    });
    // Bekräftelsen stängs också när besökaren går vidare: fokus lämnar rutan, ett tryck utanför den eller en rullning.
    const stangKvitto = () => { if (!ruta.hidden && !kvitto.hidden) { visa(false); fraga.hidden = false; kvitto.hidden = true; oppnadFran = null; } };
    ruta.addEventListener('focusout', (e) => {
      const till = (e as FocusEvent).relatedTarget as Node | null;
      if (till && !ruta.contains(till)) stangKvitto();
    });
    document.addEventListener('pointerdown', (e) => { if (!ruta.contains(e.target as Node)) stangKvitto(); });
    let rullStart = 0;
    window.addEventListener('scroll', () => {
      if (kvitto.hidden) { rullStart = scrollY; return; }
      if (Math.abs(scrollY - rullStart) > 48) stangKvitto();
    }, { passive: true });

    // Kakinställningar i sidfoten öppnar rutan igen med de val som gäller, så att det är lika lätt att ändra sig.
    // Har besökaren sagt ja till något står det att sidan laddas om om ett ja tas tillbaka.
    document.querySelectorAll<HTMLElement>('[data-samtycke-installningar]').forEach((b) => b.addEventListener('click', () => {
      const v = las();
      for (const r of rutor) r.checked = !!v?.[r.name];
      omladdning.hidden = !kategorier.some((k) => v?.[k]);
      fraga.hidden = false; kvitto.hidden = true;
      oppnadFran = b; visaVal(true); visa(true);
      rutor[0]?.focus();
    }));
  }
</script>

<style>
  .samtycke {
    position: fixed; z-index: 60; left: var(--k-a3); right: var(--k-a3); bottom: calc(var(--k-a3) + env(safe-area-inset-bottom));
    max-width: 34rem; margin-inline: auto;
    background: var(--k-bg); color: var(--k-text); border: 1px solid var(--k-linje); border-radius: var(--k-radie-kort);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.16); padding: var(--k-a3) var(--k-a4) var(--k-a2);
    max-height: calc(100dvh - 2 * var(--k-a3)); overflow-y: auto;
  }
  /* Knapplisten ligger under rutan när rutan täcker förstavyns knappar (Kontaktlist.astro). */
  :global(html[data-lista-under-ruta]) .samtycke { bottom: calc(4.5rem + env(safe-area-inset-bottom)); max-height: calc(100dvh - 5.5rem); }
  .samtycke[hidden], .samtycke [hidden] { display: none; }
  .samtycke__inre { display: grid; gap: var(--k-a2); }
  .samtycke__rubrik { font-family: var(--k-font-brod); font-size: 1rem; font-weight: 600; }
  .samtycke__text, .samtycke__kvitto p { font-size: 0.9rem; line-height: 1.5; }
  .samtycke__val { border: 0; margin: 0; padding: 0; display: grid; gap: var(--k-a3); }
  .samtycke__kategori { display: grid; grid-template-columns: auto 1fr; gap: var(--k-a2); align-items: start; font-size: 0.9rem; line-height: 1.45; }
  .samtycke__kategori input { width: 1.4rem; height: 1.4rem; margin: 0.1rem 0 0; accent-color: var(--k-accent); }
  .samtycke__omladdning { font-size: var(--k-liten); color: var(--k-dampad); }
  .samtycke__knappar { display: grid; grid-template-columns: 1fr 1fr; gap: var(--k-a2); }
  .samtycke__knappar :global(.knapp) { padding-inline: 0.75rem; min-height: 44px; padding-block: 0.5rem; }
  .samtycke__knappar [data-samtycke-svar="spara"] { grid-column: 1 / -1; }
  .samtycke__valj { grid-column: 1 / -1; justify-self: center; background: none; border: 0; border-radius: var(--k-radie-knapp); padding: 0.25rem 0.5rem; min-height: 44px; font: inherit; font-size: 0.9rem; font-weight: 600; color: var(--k-text); text-decoration: underline; cursor: pointer; }
  .samtycke__kvitto { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-a1) var(--k-a3); padding-block: var(--k-a1); }
  .samtycke__kvitto:focus-visible { outline-offset: 6px; }
  /* På låga skärmar, som en liten telefon, blir rutan kompakt så att den skymmer så lite som möjligt (NN/g, Cookie Permissions 101, riktlinje 6). */
  @media (max-height: 44rem) {
    .samtycke { padding: var(--k-a2) var(--k-a3) var(--k-a1); }
    .samtycke__inre { gap: var(--k-a1); }
    .samtycke__rubrik { font-size: 0.9rem; }
    .samtycke__text, .samtycke__kategori, .samtycke__kvitto p { font-size: 0.8rem; line-height: 1.4; }
    .samtycke__knappar :global(.knapp) { min-height: 44px; padding: 0.4rem 0.5rem; font-size: var(--k-mindre); }
    .samtycke__valj { min-height: 32px; }
  }
</style>
