---
// Hitta hit: kartbild, adress och vägbeskrivning per plats (NN/g, Contact Us: adressen länkad till kartappen).
// Kartbilden ligger på den egna servern, så inget laddas från tredje part när sidan öppnas (guide/2-8-teknik-och-kvalitet.md).
// Google-kartan laddas först när besökaren klickar, med ett besked om att Google då sätter kakor. Utan JavaScript
// öppnar samma länk Google Maps.
import Bildruta from '../komponenter/Bildruta.astro';
import Ikon from '../komponenter/Ikon.astro';
import { hartPostnummer } from '../komponenter/text';
import type { Bild, Lank, KartLank } from '../innehall/typ';
interface Plats { namn: string; adress: string; extra?: string; karta: Bild; vagbeskrivning: KartLank; appar?: Lank[]; googleKarta: { text: string; href: string; embed: string } }
interface Props { id?: string; rubrik: string; platser: Plats[]; kakText: string; kakLank?: Lank; kalla: Lank; apparEtikett?: string; }
const { id = 'hitta-hit', rubrik, platser, kakText, kakLank, kalla, apparEtikett } = Astro.props;
---
<section class="sektion hittahit" id={id} aria-labelledby={`${id}-rubrik`}>
  <div class="behallare">
    <h2 id={`${id}-rubrik`} class="hittahit__rubrik">{rubrik}</h2>
    <div class="hittahit__rutnat">
      {platser.map((p) => (
        <article class="kort hittahit__plats">
          <div class="hittahit__karta" data-karta>
            <Bildruta bild={p.karta} bredd={720} klass="hittahit__bild" />
          </div>
          <h3>{p.namn}</h3>
          <p class="hittahit__adress"><Ikon namn="plats" /><span>{hartPostnummer(p.adress)}{p.extra && <><br /><span class="dampad">{p.extra}</span></>}</span></p>
          <div class="hittahit__knappar">
            <a class="knapp knapp--primar" href={p.vagbeskrivning.href} data-apple={p.vagbeskrivning.apple} data-ny-flik rel="noopener">{p.vagbeskrivning.text}</a>
            <a class="knapp knapp--sekundar hittahit__google" href={p.googleKarta.href} data-ny-flik rel="noopener" data-embed={p.googleKarta.embed} data-titel={`Google-karta: ${p.adress}`}>{p.googleKarta.text}</a>
          </div>
          {p.appar && <p class="hittahit__appar">{apparEtikett} {p.appar.map((a, i) => <>{i > 0 && ' · '}<a href={a.href} data-ny-flik rel="noopener">{a.text}</a></>)}</p>}
          <p class="dampad hittahit__kakor">{kakText}{kakLank && <> <a href={kakLank.href}>{kakLank.text}</a></>}</p>
        </article>
      ))}
    </div>
    <p class="dampad hittahit__kalla"><a href={kalla.href} data-ny-flik rel="noopener">{kalla.text}</a></p>
  </div>
</section>

<script>
  // Klick på "Visa i Google Maps här" byter kartbilden mot Google-kartan på plats. Först då kontaktas Google.
  document.querySelectorAll<HTMLAnchorElement>('.hittahit__google').forEach((lank) => {
    lank.addEventListener('click', (e) => {
      const ruta = lank.closest('.hittahit__plats')?.querySelector<HTMLElement>('[data-karta]');
      if (!ruta || !lank.dataset.embed) return;
      e.preventDefault();
      const ram = document.createElement('iframe');
      ram.src = lank.dataset.embed;
      ram.title = lank.dataset.titel ?? 'Google-karta';
      ram.loading = 'lazy';
      ram.referrerPolicy = 'no-referrer-when-downgrade';
      ram.className = 'hittahit__ram';
      ruta.replaceChildren(ram);
      lank.remove();
      ram.focus();
    });
  });
</script>

<style>
  .hittahit__rubrik { margin-bottom: var(--k-a5); }
  /* Efter Det praktiska med samma bakgrund blir avståndet annars dubbelt (Johnnys dom 2026-10-15). */
  :global(.praktiskt) + .hittahit { padding-top: 0; }
  .hittahit__rutnat { display: grid; gap: var(--k-a4); }
  .hittahit__karta { aspect-ratio: 18 / 11; overflow: hidden; border-radius: calc(var(--k-radie-kort) - 4px); background: var(--k-linje); }
  .hittahit__karta :global(.hittahit__bild), .hittahit__karta :global(.hittahit__ram) { width: 100%; height: 100%; object-fit: cover; border: 0; display: block; }
  .hittahit__adress { display: flex; gap: var(--k-a2); align-items: flex-start; }
  .hittahit__adress :global(svg) { width: 1.1rem; height: 1.1rem; margin-top: 0.3rem; flex: none; color: var(--k-accent-text); }
  .hittahit__knappar { display: flex; flex-wrap: wrap; gap: var(--k-a3); }
  .hittahit__kakor, .hittahit__kalla { font-size: 0.85rem; }
  .hittahit__appar { font-size: 0.95rem; }
  .hittahit__appar a { display: inline-block; min-height: 24px; padding-block: 2px; }
  .hittahit__kalla { margin-top: var(--k-a4); }
  @media (max-width: 40rem) { .hittahit__knappar .knapp { flex: 1 1 100%; } }
  @media (min-width: 56rem) { .hittahit__rutnat { grid-template-columns: repeat(2, 1fr); } }
</style>
