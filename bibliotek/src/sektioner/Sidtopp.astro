---
// Sidtoppen på en undersida: sidans enda h1, en kort ingress och kontaktvägen (guide/2-3-struktur.md).
import Knapp from '../komponenter/Knapp.astro';
import type { Lank } from '../innehall/typ';
interface Props { overrad?: string; rubrik: string; ingress: string; boka?: Lank; ring?: Lank; lank?: Lank; }
const { overrad, rubrik, ingress, boka, ring, lank } = Astro.props;
---
<section class="sidtopp" aria-labelledby="sidtopp-rubrik">
  <div class="behallare sidtopp__text">
    {overrad && <p class="overrad">{overrad}</p>}
    <h1 id="sidtopp-rubrik">{rubrik}</h1>
    <p class="sidtopp__ingress">{ingress}</p>
    {(boka || ring) && (
      <div class="sidtopp__knappar">
        {boka && <Knapp href={boka.href} text={boka.text} ikon="kalender" />}
        {ring && <Knapp href={ring.href} text={ring.text} variant="sekundar" ikon="telefon" />}
      </div>
    )}
    {lank && <p><a class="sidtopp__lank" href={lank.href}>{lank.text}</a></p>}
  </div>
</section>

<style>
  .sidtopp { padding-block: var(--k-a6) var(--k-a6); }
  .sidtopp__text { display: grid; gap: var(--k-a4); }
  .sidtopp h1 { font-size: clamp(2rem, 1.5rem + 2.4vw, 3.25rem); max-width: 22ch; }
  .sidtopp__ingress { font-size: 1.125rem; max-width: 40rem; }
  .sidtopp__lank { font-weight: 600; display: inline-flex; min-height: 44px; align-items: center; }
  .sidtopp__knappar { display: flex; flex-wrap: wrap; gap: var(--k-a3); margin-top: var(--k-a2); }
  @media (max-width: 40rem) { .sidtopp__knappar :global(.knapp) { flex: 1 1 100%; } }
  @media (min-width: 56rem) { .sidtopp { padding-block: var(--k-a7) var(--k-a6); } }
</style>
