---
// Sidtoppen på en undersida: sidans enda h1, en kort ingress och kontaktvägen (guide/2-3-struktur.md).
// faktakort: på datorn ett litet kort till höger med det besökaren behöver för att boka, till exempel dagar och pris
// (Johnny 2026-10-16, kvalitetsgranskningen C5). På mobilen står kortet under knapparna, så att mobilen inte får sämre
// innehåll än datorn (premiumpasset 2026-10-16, P2). faktakortMobil={false} döljer det i mobilen, där det skulle trycka ned
// något viktigare, som ett porträtt. En rad med href blir en länk, t.ex. telefon eller e-post.
import Knapp from '../komponenter/Knapp.astro';
import Uppmaning from '../komponenter/Uppmaning.astro';
import Bildruta from '../komponenter/Bildruta.astro';
import type { IkonNamn } from '../komponenter/Ikon.astro';
import type { Lank, Bild } from '../innehall/typ';
export interface Faktakort { rubrik: string; rader: { etikett: string; text: string; href?: string }[]; lank?: Lank; }
// boka är den primära knappen och ring den sekundära; ikonerna kan bytas, t.ex. ring och mejla på en företagssida.
// not: en kort rad under knapparna, t.ex. vad man väljer i bokningen.
// portratt: ett runt porträtt överst, så att en sida om en person visar personen i första vyn (premiumpasset P24).
interface Props { portratt?: Bild; overrad?: string; rubrik: string; ingress: string; boka?: Lank; ring?: Lank; not?: string; lank?: Lank; primarIkon?: IkonNamn; sekundarIkon?: IkonNamn; faktakort?: Faktakort; faktakortMobil?: boolean; }
const { portratt, overrad, rubrik, ingress, boka, ring, not, lank, primarIkon = 'kalender', sekundarIkon = 'telefon', faktakort, faktakortMobil = true } = Astro.props;
---
<section class="sidtopp">
  <div class="behallare sidtopp__rutnat">
    <div class="sidtopp__text">
      {portratt && <div class="sidtopp__portratt"><Bildruta bild={portratt} bredd={112} laddning="eager" prioritet /></div>}
      {overrad && <p class="overrad">{overrad}</p>}
      <h1>{rubrik}</h1>
      <p class="sidtopp__ingress">{ingress}</p>
      {(boka || ring) && (
        <div class="sidtopp__knappar">
          {boka && <Knapp href={boka.href} text={boka.text} ikon={primarIkon} />}
          {ring && <Knapp href={ring.href} text={ring.text} variant="sekundar" ikon={sekundarIkon} />}
        </div>
      )}
      {not && <p class="dampad sidtopp__not">{not}</p>}
      {lank && <div><Uppmaning href={lank.href} text={lank.text} /></div>}
    </div>
    {faktakort && (
      <div class:list={['kort sidtopp__fakta', { 'sidtopp__fakta--bara-dator': !faktakortMobil }]}>
        <h2 class="sidtopp__faktarubrik">{faktakort.rubrik}</h2>
        <dl>{faktakort.rader.map((r) => <div><dt>{r.etikett}</dt><dd>{r.href ? <a class:list={[{ telefon: r.href.startsWith('tel:') }]} href={r.href}>{r.text}</a> : r.text}</dd></div>)}</dl>
        {faktakort.lank && <Uppmaning href={faktakort.lank.href} text={faktakort.lank.text} />}
      </div>
    )}
  </div>
</section>

<style>
  .sidtopp { padding-block: var(--k-a6) var(--k-a6); }
  .sidtopp__rutnat { display: grid; gap: var(--k-a6); align-items: start; }
  .sidtopp__text { display: grid; gap: var(--k-a4); }
  /* Samma tak vid stor text som i bas.css: rubriken stannar vid en andel av bredden men är alltid större än brödtexten. */
  .sidtopp h1 { font-size: max(1.3em, min(clamp(2rem, 1.5rem + 2.4vw, 3.25rem), 12vw)); max-width: 22ch; }
  .sidtopp__ingress { font-size: 1.125rem; max-width: var(--k-matt-ingress); }
  .sidtopp__portratt { width: 4.5rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--k-dekor); }
  .sidtopp__portratt :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; }
  @media (min-width: 56rem) { .sidtopp__portratt { width: 7rem; } }
  .sidtopp__knappar { display: flex; flex-wrap: wrap; gap: var(--k-a3); margin-top: var(--k-a2); }
  .sidtopp__not { font-size: var(--k-mindre); }
  .sidtopp__fakta--bara-dator { display: none; }
  .sidtopp__faktarubrik { font-size: var(--k-h3); }
  .sidtopp__fakta dl { margin: 0; display: grid; }
  .sidtopp__fakta dl div { display: grid; gap: var(--k-a1); padding-block: var(--k-a2); border-bottom: 1px solid var(--k-linje); }
  .sidtopp__fakta dt { font-weight: 600; }
  .sidtopp__fakta dd { margin: 0; font-variant-numeric: tabular-nums; }
  @media (max-width: 40rem) { .sidtopp__knappar :global(.knapp) { flex: 1 1 100%; } }
  @media (min-width: 56rem) {
    .sidtopp { padding-block: var(--k-a7) var(--k-a6); }
    .sidtopp__rutnat:has(.sidtopp__fakta) { grid-template-columns: minmax(0, 1.6fr) minmax(17rem, 1fr); gap: var(--k-a7); }
    .sidtopp__fakta, .sidtopp__fakta--bara-dator { display: flex; }
  }
</style>
