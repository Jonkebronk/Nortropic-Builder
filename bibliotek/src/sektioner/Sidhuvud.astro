---
// Sidhuvudet. På datorn: namn, fyra synliga länkar, telefon och Boka (guide/2-3-struktur.md).
// På mobilen finns två lägen (innehall.mobilLista):
//  'nere' – standard (Johnnys beslut 2026-10-15, kl. 23.35): smalt sidhuvud med "Meny" som göms när man scrollar nedåt och kommer tillbaka uppåt
//           (NN/g, Sticky Headers), och kontaktvägen i en knapplist i tumzonen (Kontaktlist.astro).
//  'uppe' – kontaktvägen fast i sidhuvudet.
// Menyn är en popover: Escape och klick utanför stänger den utan JavaScript (guide/2-4-skelett.md, primitiverna).
// Den stängs också när fokus lämnar den, så att Tab inte hamnar på sidan bakom panelen (WCAG 2.2, 2.4.11).
// knappar: sidans egna knappar när den primära handlingen inte är Boka, t.ex. Ring och Mejla på en företagssida (Johnny 2026-10-16).
import Ikon from '../komponenter/Ikon.astro';
import Knapp from '../komponenter/Knapp.astro';
import Bildruta from '../komponenter/Bildruta.astro';
import type { Lank, StartInnehall } from '../innehall/typ';
import type { Knappval } from './Kontaktlist.astro';
interface Props { innehall: StartInnehall; knappar?: { primar: Knappval; sekundar: Knappval }; }
const { foretag, boka, ring, nav, meny, mobilLista = 'nere' } = Astro.props.innehall;
const knappar = Astro.props.knappar;
const menyLankar = meny?.lankar ?? nav;
const sida = Astro.url.pathname;
// Exakt sida får aria-current="page"; en sida som hör till länken får aria-current="true" (WAI-ARIA, aria-current).
const aktuell = (l: Lank) => (l.href === sida ? 'page' : l.delar?.includes(sida) ? 'true' : undefined);
---
<header class="sidhuvud" data-sidhuvud data-lista={mobilLista}>
  <div class="behallare sidhuvud__rad">
    <a class="sidhuvud__namn" href="/">
      {foretag.logotyp && <span class="sidhuvud__logo"><Bildruta bild={foretag.logotyp} bredd={40} laddning="eager" /></span>}
      <span>{foretag.namn}</span>
    </a>
    <nav class="sidhuvud__nav" aria-label="Huvudmeny">
      <ul>{nav.map((l) => <li><a href={l.href} aria-current={aktuell(l)}>{l.text}</a></li>)}</ul>
    </nav>
    <div class="sidhuvud__kontakt">
      <a class="telefon sidhuvud__ring" href={ring.href}>
        <Ikon namn="telefon" /><span class="sr-only">Ring </span><span class="sidhuvud__ringtext">{ring.nummer}</span>
      </a>
      {knappar
        ? <a class="knapp knapp--sekundar sidhuvud__boka" href={knappar.sekundar.href}>{knappar.sekundar.text}</a>
        : <a class="knapp knapp--primar sidhuvud__boka" href={boka.href} rel="noopener">{boka.kort ?? boka.text}</a>}
      <button class="sidhuvud__menyknapp knapp-ton" type="button" popovertarget="meny">
        <Ikon namn="meny" /><span>{meny?.oppna ?? 'Meny'}</span>
      </button>
    </div>
  </div>
  <div id="meny" popover class="meny">
    <div class="meny__topp">
      <span class="meny__namn">{foretag.namn}</span>
      {/* autofocus: fokus flyttas in i panelen när den öppnas (HTML, popover focusing steps; WAI-ARIA APG, Dialog), och tillbaka till Meny när den stängs. */}
      <button class="meny__stang knapp-ton" type="button" popovertarget="meny" popovertargetaction="hide" autofocus>
        <Ikon namn="stang" /><span>{meny?.stang ?? 'Stäng'}</span>
      </button>
    </div>
    <nav aria-label={meny?.oppna ?? 'Meny'}>
      <ul class="meny__lankar">
        {menyLankar.map((l) => <li><a href={l.href} aria-current={aktuell(l)}>{l.text}</a></li>)}
      </ul>
    </nav>
    <div class="meny__knappar">
      {knappar ? <>
        <Knapp href={knappar.primar.href} text={knappar.primar.text} ikon={knappar.primar.ikon} etikett={knappar.primar.etikett} />
        <Knapp href={knappar.sekundar.href} text={knappar.sekundar.text} variant="sekundar" ikon={knappar.sekundar.ikon} etikett={knappar.sekundar.etikett} />
      </> : <>
        <Knapp href={boka.href} text={boka.text} ikon="kalender" />
        <Knapp href={ring.href} text={ring.text} variant="sekundar" ikon="telefon" />
      </>}
    </div>
  </div>
</header>

<script>
  // Läge 'nere' på mobilen: sidhuvudet göms vid scroll nedåt och kommer tillbaka vid scroll uppåt.
  // Det kräver några pixlar åt samma håll, så att det inte blinkar (NN/g, Sticky Headers).
  const h = document.querySelector<HTMLElement>('[data-sidhuvud][data-lista="nere"]');
  if (h) {
    let senast = window.scrollY;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (Math.abs(y - senast) < 12) return;
      h.dataset.dold = String(y > senast && y > 120);
      senast = y;
    }, { passive: true });
    h.addEventListener('focusin', () => { h.dataset.dold = 'false'; });
  }
  // Menyn stängs när fokus lämnar panelen, så att Tab inte hamnar på element som panelen täcker.
  const meny = document.getElementById('meny');
  meny?.addEventListener('focusout', (e) => {
    const till = (e as FocusEvent).relatedTarget as Node | null;
    if (till && !meny.contains(till) && meny.matches(':popover-open')) meny.hidePopover();
  });
</script>

<style>
  .sidhuvud {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--k-bg) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--k-linje) 70%, transparent);
    transition: transform 320ms var(--k-kurva);
  }
  .sidhuvud__rad { display: flex; align-items: center; gap: var(--k-a2); min-height: 4rem; }
  .sidhuvud__namn {
    display: flex; align-items: center; gap: var(--k-a2); min-width: 0;
    font-family: var(--k-font-rubrik); font-weight: var(--k-rubrik-vikt); text-transform: var(--k-rubrik-versaler);
    font-size: clamp(0.95rem, 0.8rem + 0.8vw, 1.2rem); color: var(--k-text); text-decoration: none; margin-right: auto;
    overflow-wrap: anywhere; line-height: 1.2;
  }
  .sidhuvud__logo { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 8px; background: var(--k-mork); padding: 5px; }
  .sidhuvud__logo :global(img) { width: 100%; height: auto; }
  .sidhuvud__nav { display: none; }
  .sidhuvud__nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--k-a5); }
  .sidhuvud__nav a { color: var(--k-text); text-decoration: none; font-weight: 400; }
  .sidhuvud__nav a[aria-current] { text-decoration: underline; text-underline-offset: 0.3em; }
  @media (hover: hover) and (pointer: fine) {
    .sidhuvud__nav a:hover, .sidhuvud__ring:hover .sidhuvud__ringtext { text-decoration: underline; text-underline-offset: 0.3em; }
  }
  .sidhuvud__kontakt { display: flex; align-items: center; gap: var(--k-a1); flex: none; }
  .sidhuvud__ring {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--k-a2);
    min-width: 48px; min-height: 48px; color: var(--k-text); text-decoration: none; font-weight: 600;
  }
  .sidhuvud__ring :global(svg) { width: var(--k-ikon); height: var(--k-ikon); }
  .sidhuvud__ringtext { display: none; }
  .sidhuvud__boka { min-height: 44px; padding: 0.5rem 0.9rem; white-space: nowrap; font-size: var(--k-mindre); }

  /* Menyknappen: ikon med ordet Meny och en ram, så att den syns som en knapp. */
  .sidhuvud__menyknapp {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0.4rem 0.75rem;
    font: inherit; font-weight: 600; font-size: var(--k-mindre); color: var(--k-text);
    background: transparent; border: 1.5px solid var(--k-linje); border-radius: var(--k-radie-knapp); cursor: pointer;
  }
  .sidhuvud__menyknapp :global(svg) { width: var(--k-ikon-text); height: var(--k-ikon-text); }

  /* Menypanelen glider in från höger, och bakgrunden tonas med den. Utgången är kortare än entrén, cirka 0,7 gånger
     (NN/g, Animation Duration; Kowalski, Modal), så att menyn stängs utan att man väntar på den (premiumpasset 2026-10-16, P3). */
  .meny {
    position: fixed; inset: 0 0 0 auto; margin: 0; height: 100dvh; width: min(100%, 24rem); max-height: none;
    padding: var(--k-a4) var(--k-a5) calc(var(--k-a5) + env(safe-area-inset-bottom));
    border: 0; border-left: 1px solid var(--k-linje); background: var(--k-yta); color: var(--k-text);
    overflow-y: auto; overscroll-behavior: contain;
    transform: translateX(100%); transition: transform 210ms var(--k-kurva), display 210ms allow-discrete, overlay 210ms allow-discrete;
  }
  .meny:popover-open { display: flex; flex-direction: column; gap: var(--k-a5); transform: none; transition-duration: 300ms; }
  @starting-style { .meny:popover-open { transform: translateX(100%); } }
  .meny::backdrop { background: rgb(0 0 0 / 0.35); opacity: 0; transition: opacity 210ms linear, display 210ms allow-discrete, overlay 210ms allow-discrete; }
  .meny:popover-open::backdrop { opacity: 1; transition-duration: 300ms; }
  @starting-style { .meny:popover-open::backdrop { opacity: 0; } }
  .meny__topp { display: flex; align-items: center; justify-content: space-between; gap: var(--k-a3); border-bottom: 1px solid var(--k-linje); padding-bottom: var(--k-a3); }
  .meny__namn { font-family: var(--k-font-rubrik); font-weight: var(--k-rubrik-vikt); text-transform: var(--k-rubrik-versaler); font-size: var(--k-storre); }
  .meny__stang { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; padding: 0.4rem 0.6rem; font: inherit; font-weight: 600; color: var(--k-text); background: none; border: 0; border-radius: var(--k-radie-knapp); cursor: pointer; }
  .meny__stang :global(svg) { width: var(--k-ikon); height: var(--k-ikon); }
  .meny__lankar { list-style: none; margin: 0; padding: 0; display: grid; }
  .meny__lankar a { display: flex; align-items: center; min-height: 52px; color: var(--k-text); text-decoration: none; font-size: var(--k-storre); font-weight: 400; border-bottom: 1px solid var(--k-linje); }
  .meny__lankar a[aria-current] { color: var(--k-accent-text); font-weight: 600; }
  .meny__knappar { display: grid; gap: var(--k-a3); margin-top: auto; }

  /* Under 360 px: tätare sidhuvud så att namnet får plats. */
  @media (max-width: 22.5rem) {
    .sidhuvud__rad { width: min(100% - 2rem, var(--k-max)); gap: 2px; }
    .sidhuvud__namn { font-size: 0.9rem; }
    .sidhuvud__boka { padding: 0.45rem 0.7rem; font-size: 0.875rem; }
    .sidhuvud__ring { display: none; }
  }
  /* Läge 'nere' på mobilen: inget telefon och ingen Boka i sidhuvudet; de ligger i knapplisten. */
  @media (max-width: 63.99rem) {
    .sidhuvud[data-lista="nere"] .sidhuvud__ring, .sidhuvud[data-lista="nere"] .sidhuvud__boka { display: none; }
    .sidhuvud[data-lista="nere"][data-dold="true"] { transform: translateY(-100%); }
  }
  /* Med reducerad rörelse glider inget: panelen tonas in, eftersom opacitet inte är rörelse (WCAG 2.2, 2.3.3). */
  @media (prefers-reduced-motion: reduce) {
    .sidhuvud { transition: none; }
    .meny, .meny:popover-open { transform: none; }
    .meny { opacity: 0; transition: opacity 150ms linear, display 150ms allow-discrete, overlay 150ms allow-discrete; }
    .meny:popover-open { opacity: 1; }
    @starting-style { .meny:popover-open { opacity: 0; } }
  }
  /* Vid mycket låg höjd (400 % zoom, liggande mobil) är sidhuvudet statiskt (WCAG 2.2, Understanding 1.4.10; Johnny 2026-10-16). */
  @media (max-height: 30rem) {
    .sidhuvud, .sidhuvud[data-dold="true"] { position: static; transform: none; }
  }
  /* Utan Popover API göms menyknappen, så att den aldrig blir en knapp som inte gör något; sidfoten har alla sidor. */
  @supports not selector(:popover-open) {
    .sidhuvud__menyknapp, .meny { display: none; }
  }
  /* På datorn bryts varken namnet eller menyvalen: ett namn delat mitt i ordet och menyval på två rader såg trasigt ut
     vid 1024–1079 px (premiumpasset 2026-10-16). */
  @media (min-width: 64rem) {
    .sidhuvud__rad { min-height: 5rem; gap: var(--k-a6); }
    .sidhuvud__nav { display: block; }
    .sidhuvud__menyknapp { display: none; }
    .sidhuvud__ringtext { display: inline; }
    /* Namnet krymper aldrig, så att ett långt namn inte skrivs över menyn; menyvalen bryts i stället till fler rader. */
    .sidhuvud__namn { margin-right: 0; white-space: nowrap; overflow-wrap: normal; flex: none; }
    .sidhuvud__nav ul { flex-wrap: wrap; row-gap: var(--k-a1); }
    .sidhuvud__nav { margin-right: auto; }
    .sidhuvud__nav a { white-space: nowrap; }
    .sidhuvud__kontakt { gap: var(--k-a5); }
  }
  /* Mellan 1024 och 1200 px är avstånden tätare, så att namn, fyra länkar, telefon och Boka får plats på en rad. */
  @media (min-width: 64rem) and (max-width: 74.99rem) {
    .sidhuvud__rad { gap: var(--k-a4); }
    .sidhuvud__nav ul { gap: var(--k-a4); }
    .sidhuvud__kontakt { gap: var(--k-a3); }
  }
</style>
