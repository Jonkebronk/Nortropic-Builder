---
// Lucide-ikoner (ISC) och en egen ikon som inline-SVG, utan JavaScript. Bara de ikoner som används importeras.
import telefon from 'lucide-static/icons/phone.svg?raw';
import kalender from 'lucide-static/icons/calendar-check.svg?raw';
import plats from 'lucide-static/icons/map-pin.svg?raw';
import klocka from 'lucide-static/icons/clock.svg?raw';
import stjarna from 'lucide-static/icons/star.svg?raw';
import pil from 'lucide-static/icons/arrow-right.svg?raw';
import meny from 'lucide-static/icons/menu.svg?raw';
// Nålen och ryggraden är egna, ritade i Lucides stil (24 px, linje 2, runda ändar), eftersom Lucide saknar en akupunkturnål
// (Johnny 2026-10-16) och en ryggrad. Lucides pulskurva lästes som hjärta (kvalitetsgranskningen 2026-10-16, U27).
import nal from './ikoner/nal.svg?raw';
import ryggrad from './ikoner/ryggrad.svg?raw';
import vag from 'lucide-static/icons/waves.svg?raw';
import foretag from 'lucide-static/icons/briefcase.svg?raw';
import mejl from 'lucide-static/icons/mail.svg?raw';
import stang from 'lucide-static/icons/x.svg?raw';
import chevron from 'lucide-static/icons/chevron-down.svg?raw';

const ikoner = { telefon, kalender, plats, klocka, stjarna, pil, meny, ryggrad, nal, vag, foretag, mejl, stang, chevron } as const;
export type IkonNamn = keyof typeof ikoner;
interface Props { namn: IkonNamn; }
const { namn } = Astro.props;
const svg = ikoner[namn].replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<Fragment set:html={svg} />
